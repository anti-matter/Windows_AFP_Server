IDD_MAIN_DIALOG DIALOGEX 0, 0, 449, 246
STYLE DS_SETFONT | DS_3DLOOK | DS_CENTER | WS_POPUP | WS_CAPTION
CAPTION "Personal AFP Server Configuration"
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
    DEFPUSHBUTTON   "Done",IDC_CLOSE,392,225,50,14
    GROUPBOX        "Login Message",IDC_STATIC,7,155,253,83
    EDITTEXT        IDC_LOGIN_MSG,17,192,233,38,ES_MULTILINE | ES_AUTOVSCROLL
    CONTROL         "Allow guests to login",IDC_ALLOW_GUESTS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,279,56,80,10
    LTEXT           "Maximum simultaneous connections:",IDC_STATIC,279,94,118,8
    EDITTEXT        IDC_MAX_CONNECTIONS,397,92,34,14,ES_AUTOHSCROLL | ES_NUMBER
    GROUPBOX        "Shares",IDC_STATIC,7,41,253,107
    LISTBOX         IDC_SHARES,18,56,158,54,LBS_SORT | LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "New",IDC_NEWVOLUME,193,67,50,14
    PUSHBUTTON      "Remove",IDC_REMOVEVOL,193,84,50,14
    PUSHBUTTON      "Send Message",IDC_SENDMSG,316,123,76,14
    LTEXT           "This is the message clients will receive each time they log into the Server. Your message may contain up to 199 characters.",IDC_STATIC,18,168,230,21
    PUSHBUTTON      "Shutdown Server",IDC_QUITBUTTON,302,166,104,14
    RTEXT           "Version 1.0",IDC_STATIC,382,7,60,10
    GROUPBOX        "Users",IDC_STATIC,268,41,174,107
    LTEXT           "No share selected",IDC_VOLPATH,18,118,235,8
    CONTROL         "Volume is read only",IDC_VOLREADONLY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,132,77,10
    CONTROL         "Disable clear text logins (require encryption)",IDC_REQ_ENCRYPTION,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,279,70,156,10
    CONTROL         IDB_BITMAP2,IDC_STATIC,"Static",SS_BITMAP,7,7,191,33
    PUSHBUTTON      "About",IDC_ABOUT,302,186,104,14
END

IDD_SENDMESSAGE DIALOGEX 0, 0, 236, 161
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Send Message"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
