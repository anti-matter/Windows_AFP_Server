/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_MAIN_DIALOG DIALOGEX 0, 0, 449, 212
STYLE DS_SETFONT | DS_3DLOOK | DS_CENTER | WS_POPUP | WS_CAPTION
EXSTYLE WS_EX_APPWINDOW
CAPTION "Apple Filing Protocol Server Configuration"
FONT 10, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
    DEFPUSHBUTTON   "Done",IDC_CLOSE,392,190,50,14
    GROUPBOX        "Login Message",IDC_STATIC,7,122,253,83
    EDITTEXT        IDC_LOGIN_MSG,17,159,233,38,ES_MULTILINE | ES_AUTOVSCROLL
    CONTROL         "Allow guests to login",IDC_ALLOW_GUESTS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,279,23,80,10
    CTEXT           "Maximum simultaneous connections:",IDC_STATIC,268,54,174,8
    EDITTEXT        IDC_MAX_CONNECTIONS,314,65,34,12,ES_AUTOHSCROLL | ES_NUMBER
    GROUPBOX        "Shares",IDC_STATIC,7,8,253,107
    LISTBOX         IDC_SHARES,18,23,158,54,LBS_SORT | LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "New",IDC_NEWVOLUME,193,34,50,14
    PUSHBUTTON      "Remove",IDC_REMOVEVOL,193,51,50,14
    PUSHBUTTON      "Send Message",IDC_SENDMSG,316,92,76,14
    LTEXT           "This is the message clients will receive each time they log into the Server. Your message may contain up to 199 characters.",IDC_STATIC,18,135,230,21
    PUSHBUTTON      "Shutdown",IDC_QUITBUTTON,329,190,50,14
    RTEXT           "1.0",IDC_VERSION_TEXT,410,2,31,10
    GROUPBOX        "Users",IDC_STATIC,268,8,174,107
    LTEXT           "No share selected",IDC_VOLPATH,18,85,235,8
    CONTROL         "Volume is read only",IDC_VOLREADONLY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,99,77,10
    CONTROL         "Disable clear text logins/require encryption",IDC_REQ_ENCRYPTION,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,279,37,156,10
    PUSHBUTTON      "About",IDC_ABOUT,265,190,50,14
    GROUPBOX        "Line Ending Conversion",IDC_STATIC,268,122,174,63
    LTEXT           "Line endings in files with the following extensions will be converted to Unix (LF) when saved to the server and back to MacOS (CR) when read.",IDC_STATIC,280,133,155,35
    EDITTEXT        IDC_CONVERT_EXTENSIONS,279,166,154,13,ES_AUTOHSCROLL
    LTEXT           "(0 for unlimited)",IDC_STATIC,352,66,55,8
END

IDD_SENDMESSAGE DIALOGEX 0, 0, 236, 161
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Send Message"
FONT 10, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
    DEFPUSHBUTTON   "SEND",IDOK,179,140,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,120,140,50,14
    GROUPBOX        "Send Client Message",IDC_STATIC,7,7,222,126
    LTEXT           "The message below will be sent to all connected clients.",IDC_STATIC,14,23,189,12
    EDITTEXT        IDC_MESSAGE,14,38,208,86,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_WANTRETURN | WS_VSCROLL
END

IDD_ABOUT DIALOGEX 0, 0, 289, 111
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP
EXSTYLE WS_EX_TOPMOST
FONT 10, "Nirmala UI", 400, 0, 0x0
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,118,91,55,14,BS_CENTER
    CONTROL         IDB_BITMAP2,IDC_STATIC,"Static",SS_BITMAP | SS_CENTERIMAGE,47,7,191,33
    GROUPBOX        "",IDC_STATIC,26,42,239,38
    CTEXT           "Copyright (c) 2025, Michael J. Conrad.",IDC_STATIC,34,51,224,14
    CTEXT           "A personal Apple Filing Protocol (AFP) server for Windows.",IDC_STATIC,31,65,228,8
    RTEXT           "1.0.0",IDC_VERSION_TEXT,260,7,22,10
END


