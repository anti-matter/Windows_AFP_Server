/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//
// The main management window is created and custom-drawn in code
// (afp-source/ui/main_window.cpp); only the secondary dialogs are
// template based.
//

IDD_SENDMESSAGE DIALOGEX 0, 0, 320, 152
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Send Message to Mac Clients"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    LTEXT           "The message below will appear on the screens of connected Macintosh clients.",IDC_STATIC,14,12,292,10
    LTEXT           "",IDC_CLIENT_COUNT,14,27,292,10
    EDITTEXT        IDC_MESSAGE,14,44,292,78,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_WANTRETURN | WS_VSCROLL
    DEFPUSHBUTTON   "Send",IDOK,250,130,56,16,BS_OWNERDRAW
    PUSHBUTTON      "Cancel",IDCANCEL,190,130,56,16,BS_OWNERDRAW
END

IDD_ABOUT DIALOGEX 0, 0, 300, 116
CAPTION "About"
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,224,92,56,16,BS_OWNERDRAW
END


